# Copy to .env and fill in. Never commit .env.

# --- Access: clients send this as header X-API-Key ---
# Generate one with: openssl rand -hex 24
SC_API_KEY=

# --- Claude ---
# claude_cli    = your Claude Pro/Max subscription via the official Claude Code CLI (personal use)
# anthropic_api = pay-per-token Anthropic API key
# auto          = API key if ANTHROPIC_API_KEY is set, otherwise the CLI
LLM_PROVIDER=claude_cli

# Subscription: run `claude setup-token` on your laptop and paste the token here.
CLAUDE_CODE_OAUTH_TOKEN=

# API key mode only. Leave EMPTY in subscription mode (it would take priority).
ANTHROPIC_API_KEY=

# Model and effort. Cheaper/faster options: claude-sonnet-5-5, claude-haiku-5-5
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=low
# Claude calls running at the same time (each CLI call uses ~300 MB RAM)
LLM_MAX_CONCURRENCY=2
LLM_TIMEOUT_S=300
# Page text sent per Claude call; bigger pages are split and merged
MAX_CONTENT_CHARS=300000

# --- Browser ---
BROWSER_ENABLED=true
BROWSER_MAX_PAGES=3
FETCH_TIMEOUT_S=30
# Optional outbound proxy for scraping, e.g. http://user:pass@host:port
SCRAPE_PROXY_URL=
# Keep false on a VPS: stops requests to localhost / private networks
ALLOW_PRIVATE_URLS=false

# --- Web search for SearchScraper: duckduckgo | searxng | brave ---
SEARCH_PROVIDER=duckduckgo
SEARXNG_URL=
BRAVE_API_KEY=

# --- HTTPS (docker-compose Caddy). Point the domain's A record at the VPS first. ---
DOMAIN=scrape.example.com
