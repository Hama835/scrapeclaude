# Copy to .env and fill in. Never commit .env. On the server: chmod 600 .env

# --- Access ---
# Clients send this as header X-API-Key (or Bearer). At least 32 characters; several keys separated by commas.
# Generate one with: openssl rand -hex 32
SC_API_KEY=
# The server refuses to start with an empty key unless this is true (local experiments only).
ALLOW_NO_AUTH=false
# Lock a client IP out after this many failed logins within the window.
AUTH_FAIL_LIMIT=20
AUTH_FAIL_WINDOW_S=600
# Dashboard login session lifetime (seconds).
SESSION_TTL_S=43200
# Dashboard sign-in (one person). Make the hash with:  python -m app.hashpw
# If both are empty the dashboard signs in with SC_API_KEY instead.
DASHBOARD_EMAIL=
DASHBOARD_PASSWORD_HASH=

# --- Claude ---
# claude_cli    = your Claude Pro/Max subscription via the official Claude Code CLI (personal use)
# anthropic_api = pay-per-token Anthropic API key
# auto          = API key if ANTHROPIC_API_KEY is set, otherwise the CLI
LLM_PROVIDER=claude_cli

# Subscription: run `claude setup-token` on your laptop and paste the token here.
CLAUDE_CODE_OAUTH_TOKEN=

# API key mode only. Leave EMPTY in subscription mode (it would take priority).
ANTHROPIC_API_KEY=

# Model and effort. Cheaper/faster options: claude-sonnet-5-5, claude-haiku-5-5
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=low
# Claude calls running at the same time (each CLI call uses ~300 MB RAM)
LLM_MAX_CONCURRENCY=2
LLM_TIMEOUT_S=300
# Page text sent per Claude call; bigger pages are split and merged
MAX_CONTENT_CHARS=300000

# --- Browser ---
BROWSER_ENABLED=true
# docker-compose sets BROWSER_WS_URL=ws://browser:3000/ (Chromium in its own container).
# Leave empty to launch Chromium locally (systemd / development).
BROWSER_WS_URL=
# Only if a local Chromium cannot start its sandbox. Never set this where untrusted sites are scraped.
CHROMIUM_NO_SANDBOX=false
BROWSER_MAX_PAGES=3
FETCH_TIMEOUT_S=30
# Largest page / sitemap we accept from a target site (bytes).
MAX_FETCH_BYTES=10000000
# Optional outbound proxy for scraping, e.g. http://user:pass@host:port
SCRAPE_PROXY_URL=
# Keep false on a VPS: stops requests to localhost / private networks
ALLOW_PRIVATE_URLS=false

# --- Jobs / history ---
# A background crawl is failed after this many seconds.
CRAWL_TIMEOUT_S=1800
# Delete history (results, scraped HTML) older than this many days. 0 = keep forever.
HISTORY_RETENTION_DAYS=30

# --- Web search for SearchScraper: duckduckgo | searxng | brave ---
SEARCH_PROVIDER=duckduckgo
SEARXNG_URL=
BRAVE_API_KEY=

# --- HTTPS (docker-compose Caddy). Point the domain's A record at the VPS first. ---
DOMAIN=scrape.example.com
